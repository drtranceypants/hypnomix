desc:Hypnomix Main (the song card, and the mix measured for the HypnoMix app; audio passes through)
//tags: analysis meter hypnomix
//author: hypnomix
// Put it LAST on the master track. The song card: genre, key and scale (tuning and harmony use them instead of
// guessing), the loudness target, true-peak ceiling, limiter character and amount (the loudness checks and the
// mastering proposals use them). It also measures the mix like a Hypnomix Probe.
options:gmem=hypnomix

slider1:genre=0<0,18,1{not set,pop,rock,indie,folk,country,singer-songwriter,r&b / soul,hip-hop,electronic,dance,ambient,jazz,blues,metal,orchestral,world,psychedelic,other}>Genre
slider2:key=0<0,12,1{not set,C,C#,D,Eb,E,F,F#,G,Ab,A,Bb,B}>Key
slider3:scale=0<0,6,1{major,minor,dorian,phrygian,lydian,mixolydian,locrian}>Scale
slider4:mode=0<0,2,1{clean,punch,loud}>Limiter
slider5:target=-14<-24,-6,0.5>Target LUFS
slider6:ceiling=-1<-3,0,0.1>Ceiling dBTP
slider7:amount=100<0,100,1>Amount %
slider8:slot=-1<-1,4095,1>-slot (set by hypnomix)
slider9:abgain=0<-12,12,0.01>-match gain dB (set by hypnomix during A/B)

// The meter, and the A/B match gain (slider9, applied after measuring), are in the include: an effect's own
// @init / @sample would REPLACE the imported ones (measured in REAPER 7.86), so Main has only @gfx of its own.
import hypnomix_meter.jsfx-inc

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@gfx 460 132
// Record and review before export: a press goes to the hypnomix bridge (gmem[8] counts presses); the bridge plays
// the project from the edit cursor and keeps what played, the app renders that stretch of the master and reviews it.
// gmem[9] is the state the bridge reports (0 idle, 1 recording, 2 rendering, 3 no app, 4 reviewing, 5 too short,
// 6 the review failed), gmem[10] seconds.
rr_state = gmem[9];
rr_x = 8; rr_y = 8; rr_w = 250; rr_h = 26;
gfx_set(0.12, 0.10, 0.09, 1); gfx_rect(0, 0, gfx_w, gfx_h);
rr_state == 1 ? gfx_set(0.75, 0.2, 0.25, 1) : gfx_set(0.56, 0.25, 0.25, 1);
gfx_rect(rr_x, rr_y, rr_w, rr_h);
gfx_set(1, 1, 1, 1);
gfx_x = rr_x + 10; gfx_y = rr_y + 7;
gfx_drawstr(rr_state == 1 ? "Stop and review" : "Record and review before export");
gfx_set(0.85, 0.8, 0.72, 1);
gfx_x = rr_x; gfx_y = rr_y + rr_h + 9;
rr_pressed > 0 && rr_state != rr_from ? (rr_pressed = 0);
rr_pressed > 0 && time_precise() - rr_pressed > 1.5 ? (
  gfx_drawstr("No answer: start the bridge (hypnomix reaper start) and the HypnoMix app");
) : rr_state == 1 ? (
  gfx_drawstr("Recording the master: "); gfx_drawnumber(gmem[10], 1); gfx_drawstr(" s. Stop here or stop REAPER.");
) : rr_state == 2 ? (
  gfx_drawstr("Rendering what played; the review then opens in the HypnoMix app");
) : rr_state == 3 ? (
  gfx_drawstr("The HypnoMix app did not answer: open it (hypnomix app), then try again");
) : rr_state == 4 ? (
  gfx_drawstr("Reviewing in the HypnoMix app");
) : rr_state == 5 ? (
  gfx_drawstr("Under a second played: nothing to review. Press again to record");
) : rr_state == 6 ? (
  gfx_drawstr("The review could not run: the HypnoMix app says why");
) : (
  gfx_drawstr("Plays from the edit cursor while every probe listens");
);
rr_down = mouse_cap & 1;
rr_in = mouse_x >= rr_x && mouse_x < rr_x + rr_w && mouse_y >= rr_y && mouse_y < rr_y + rr_h;
rr_down && !rr_was ? rr_armed = rr_in;
// a press counts on RELEASE over the button (like any button): REAPER does not start playing while the mouse is
// still held down in an FX window (measured in 7.86), so acting on mouse-down left a held click with no playback
!rr_down && rr_was && rr_armed && rr_in ? (
  gmem[8] += 1; rr_pressed = time_precise(); rr_from = rr_state;
);
!rr_down ? rr_armed = 0;
rr_was = rr_down;

// The mastering chain (masterchain.lua in the bridge): presses counted in gmem[11] Build, gmem[12] Match target,
// gmem[13] Save; the bridge reports gmem[14] (state) with gmem[15] and gmem[16] (two numbers for it).
mc_y = 70; mc_h = 24; mc_w = 108;
mc_state = gmem[14]; mc_a = gmem[15]; mc_b = gmem[16];
gfx_set(0.85, 0.8, 0.72, 1); gfx_x = 8; gfx_y = mc_y - 14; gfx_drawstr("Mastering chain (REAPER's own plug-ins, before this one)");
mc_down = mouse_cap & 1;
mc_i = 0;
loop(3,
  gfx_set(mc_state == 2 && mc_i == 1 ? 0.45 : 0.32, 0.30, 0.26, 1);
  gfx_rect(8 + mc_i * (mc_w + 8), mc_y, mc_w, mc_h);
  gfx_set(0.95, 0.93, 0.89, 1); gfx_x = 18 + mc_i * (mc_w + 8); gfx_y = mc_y + 6;
  gfx_drawstr(mc_i == 0 ? "Build chain" : mc_i == 1 ? (mc_state == 2 ? "Stop matching" : "Match target") : "Save chain");
  // like Record: armed on press, counted on RELEASE over the same button (REAPER does not start playing while the
  // mouse is held in an FX window, and Match target starts playback)
  mc_in = mouse_x >= 8 + mc_i * (mc_w + 8) && mouse_x < 8 + mc_i * (mc_w + 8) + mc_w && mouse_y >= mc_y && mouse_y < mc_y + mc_h;
  mc_down && !mc_was && mc_in ? mc_armed = mc_i + 1;
  !mc_down && mc_was && mc_armed == mc_i + 1 ? (
    mc_in ? (gmem[11 + mc_i] += 1; mc_pressed = time_precise(); mc_from = mc_state;);
    mc_armed = 0;
  );
  mc_i += 1;
);
!mc_down && mc_was ? mc_armed = 0;
mc_was = mc_down;
gfx_set(0.85, 0.8, 0.72, 1); gfx_x = 8; gfx_y = mc_y + mc_h + 9;
mc_pressed > 0 && mc_state != mc_from ? (mc_pressed = 0);
mc_pressed > 0 && time_precise() - mc_pressed > 1.5 && mc_state == mc_from && mc_state != 2 ? (
  gfx_drawstr("No answer: start the bridge (hypnomix reaper start)");
) : mc_state == 1 ? (
  gfx_drawstr("Built: "); gfx_drawnumber(mc_a, 0); gfx_drawstr(" plug-ins, gains at 0 dB. Open the FX chain to edit.");
  mc_b > 0 ? (gfx_x = 8; gfx_y += 14; gfx_drawnumber(mc_b, 0); gfx_drawstr(" settings not found: see the ReaScript console"));
) : mc_state == 13 ? (
  gfx_drawstr("Built from your template: "); gfx_drawnumber(mc_a, 0); gfx_drawstr(" plug-ins");
) : mc_state == 2 ? (
  mc_b == 1 ? gfx_drawstr("Matching: play the loudest part (round 1, 8 s)") : (
    gfx_drawstr("Measured "); gfx_drawnumber(mc_a, 1); gfx_drawstr(" LUFS; round "); gfx_drawnumber(mc_b, 0););
) : mc_state == 3 ? (
  gfx_drawstr("Master "); gfx_drawnumber(mc_a, 1); gfx_drawstr(" LUFS: on target. ReaLimit gain "); gfx_drawnumber(mc_b, 1); gfx_drawstr(" dB");
) : mc_state == 10 ? (
  gfx_drawstr("Master "); gfx_drawnumber(mc_a, 1); gfx_drawstr(" LUFS, ReaLimit gain "); gfx_drawnumber(mc_b, 1);
  gfx_drawstr(" dB:"); gfx_x = 8; gfx_y += 14; gfx_drawstr("the limiter is working hard. Lower the target, or less dynamics first");
) : mc_state == 4 ? (
  gfx_drawstr("Saved "); gfx_drawnumber(mc_a, 0); gfx_drawstr(" plug-ins as a template (FXChains/hypnomix)");
) : mc_state == 5 ? (
  gfx_drawstr("No ReaLimit before this effect: build the chain, or add ReaLimit");
) : mc_state == 6 ? (
  gfx_drawstr("Matching stopped: REAPER stopped playing");
) : mc_state == 7 ? (
  gfx_drawstr("Cancelled");
) : mc_state == 8 ? (
  gfx_drawstr("The master is silent: play the song, then Match target");
) : mc_state == 9 ? (
  gfx_drawstr("Something went wrong: see the ReaScript console");
) : mc_state == 11 ? (
  gfx_drawstr("Put Hypnomix Main on the master first");
) : mc_state == 12 ? (
  gfx_drawstr("Nothing to save: no plug-ins before this effect");
) : mc_state == 14 ? (
  gfx_drawstr("Waiting for your answer in REAPER (a menu or a dialog)");
) : (
  gfx_drawstr("Build adds a neutral chain; Save keeps yours as a template");
);
