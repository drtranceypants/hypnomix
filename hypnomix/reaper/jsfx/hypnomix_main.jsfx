desc:Hypnomix Main (the song card, and the mix measured for the hypnomix app; audio passes through)
//tags: analysis meter hypnomix
//author: hypnomix
// Put it LAST on the master track. The song card: genre, key and scale (tuning and harmony use them instead of
// guessing), the loudness target, true-peak ceiling, limiter character and amount (the loudness checks and the
// mastering proposals use them). It also measures the mix like a Hypnomix Probe.
options:gmem=hypnomix

slider1:genre=0<0,18,1{not set,pop,rock,indie,folk,country,singer-songwriter,r&b / soul,hip-hop,electronic,dance,ambient,jazz,blues,metal,orchestral,world,psychedelic,other}>Genre
slider2:key=0<0,12,1{not set,C,C#,D,Eb,E,F,F#,G,Ab,A,Bb,B}>Key
slider3:scale=0<0,6,1{major,minor,dorian,phrygian,lydian,mixolydian,locrian}>Scale
slider4:mode=0<0,2,1{clean,punch,loud}>Limiter
slider5:target=-14<-24,-6,0.5>Target LUFS
slider6:ceiling=-1<-3,0,0.1>Ceiling dBTP
slider7:amount=100<0,100,1>Amount %
slider8:slot=-1<-1,4095,1>-slot (set by hypnomix)
slider9:abgain=0<-12,12,0.01>-match gain dB (set by hypnomix during A/B)

// The meter, and the A/B match gain (slider9, applied after measuring), are in the include: an effect's own
// @init / @sample would REPLACE the imported ones (measured in REAPER 7.86), so Main has only @gfx of its own.
import hypnomix_meter.jsfx-inc

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@gfx 460 64
// Record and review before export: a press goes to the hypnomix bridge (gmem[8] counts presses); the bridge plays
// the project from the edit cursor and keeps what played, the app renders that stretch of the master and reviews it.
// gmem[9] is the state the bridge reports (0 idle, 1 recording, 2 rendering, 3 no app, 4 reviewing), gmem[10] seconds.
rr_state = gmem[9];
rr_x = 8; rr_y = 8; rr_w = 250; rr_h = 26;
gfx_set(0.12, 0.10, 0.09, 1); gfx_rect(0, 0, gfx_w, gfx_h);
rr_state == 1 ? gfx_set(0.75, 0.2, 0.25, 1) : gfx_set(0.56, 0.25, 0.25, 1);
gfx_rect(rr_x, rr_y, rr_w, rr_h);
gfx_set(1, 1, 1, 1);
gfx_x = rr_x + 10; gfx_y = rr_y + 7;
gfx_drawstr(rr_state == 1 ? "Stop and review" : "Record and review before export");
gfx_set(0.85, 0.8, 0.72, 1);
gfx_x = rr_x; gfx_y = rr_y + rr_h + 9;
rr_pressed > 0 && rr_state != rr_from ? (rr_pressed = 0);
rr_pressed > 0 && time_precise() - rr_pressed > 1.5 ? (
  gfx_drawstr("No answer: start the bridge (hypnomix reaper start) and the hypnomix app");
) : rr_state == 1 ? (
  gfx_drawstr("Recording the master: "); gfx_drawnumber(gmem[10], 1); gfx_drawstr(" s. Stop here or stop REAPER.");
) : rr_state == 2 ? (
  gfx_drawstr("Rendering what played; the review then opens in the hypnomix app");
) : rr_state == 3 ? (
  gfx_drawstr("The hypnomix app did not answer: open it (hypnomix app), then try again");
) : rr_state == 4 ? (
  gfx_drawstr("Reviewing in the hypnomix app");
) : (
  gfx_drawstr("Plays from the edit cursor while every probe listens");
);
rr_down = mouse_cap & 1;
rr_down && !rr_was && mouse_x >= rr_x && mouse_x < rr_x + rr_w && mouse_y >= rr_y && mouse_y < rr_y + rr_h ? (
  gmem[8] += 1; rr_pressed = time_precise(); rr_from = rr_state;
);
rr_was = rr_down;
